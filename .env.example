# `pnpm cms:setup` generates a private .env with random secrets.
# Supply equivalent environment variables when deploying.
PAYLOAD_SECRET=
# Use a URL-safe password (for example a random hex string).
POSTGRES_PASSWORD=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
POSTGRES_PORT=54329

# Only used by Payload CLI / pnpm dev on the host; Compose supplies its own URL.
DATABASE_URL=postgres://cwb:YOUR_POSTGRES_PASSWORD@127.0.0.1:54329/cwb
PAYLOAD_UPLOAD_DIR=storage/media
# Public origin used for absolute media links and password reset emails.
# Set to https://your-domain.example when deployed; leave blank for local relative URLs.
PAYLOAD_PUBLIC_SERVER_URL=

CONTACT_FORM_SECRET=
CONTACT_FROM=mail@wojciechbajer.com
CONTACT_RECIPIENT=mail@wojciechbajer.com
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
