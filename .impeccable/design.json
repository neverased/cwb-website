    {
      "name": "Service choice",
      "kind": "custom",
      "refersTo": "service-choice",
      "description": "One need-based route with an explicit selected state.",
      "html": "<a class=\"ds-choice\" href=\"/services/?service=audits\" aria-current=\"true\"><span><strong>Review a system</strong><span>Find the risks and decide what to fix first.</span></span><span aria-hidden=\"true\">↗</span></a>",
      "css": ".ds-choice{font-family:var(--font-display,\"Space Grotesk\"),sans-serif;display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:7.5rem;padding:1.25rem 1.2rem 1.25rem 0;border-block:1px solid var(--rule-soft,#26322f);color:var(--accent-mint,#a3e8be);text-decoration:none}.ds-choice>span:first-child{display:grid;gap:.6rem}.ds-choice strong{font-size:clamp(1.2rem,2vw,1.65rem);font-weight:500;line-height:1.2;letter-spacing:-.035em}.ds-choice>span>span{color:var(--text-muted,#a8b5b0);font-size:.875rem;line-height:1.55;max-width:29ch}.ds-choice>span:last-child{transition:transform 240ms ease}.ds-choice:hover>span:last-child{transform:translate(3px,-3px)}.ds-choice:focus-visible{outline:2px solid var(--accent-mint,#a3e8be);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-choice>span:last-child{transition:none}}"
