    {
      "name": "Service result",
      "kind": "card",
      "refersTo": "service-panel",
      "description": "The selected service with a readable outcome and a direct contact link.",
      "html": "<section class=\"ds-result\"><p>Audits</p><h3>Get an independent read on product, process, and technical reality.</h3><a href=\"/contact/?service=audits\">Discuss an audit <span aria-hidden=\"true\">↗</span></a></section>",
      "css": ".ds-result{font-family:var(--font-display,\"Space Grotesk\"),sans-serif;border:1px solid var(--rule-strong,#566e61);background:var(--surface-panel,#111819);color:var(--page-foreground,#edf2ef);padding:clamp(1.25rem,2.7vw,2.25rem)}.ds-result>p{font-family:var(--font-mono,\"Fira Code\"),monospace;font-size:.75rem;color:var(--text-muted,#a8b5b0);margin:0 0 1.75rem}.ds-result h3{font-size:clamp(1.7rem,2.65vw,2.35rem);font-weight:400;line-height:1.15;letter-spacing:-.045em;max-width:28ch}.ds-result a{display:inline-flex;align-items:center;gap:1rem;min-height:44px;color:var(--accent-mint,#a3e8be);text-decoration:none}.ds-result:focus-within{border-color:var(--accent-mint,#a3e8be)}.ds-result a:hover{text-decoration:underline;text-underline-offset:.3em}.ds-result a:focus-visible{outline:2px solid var(--accent-mint,#a3e8be);outline-offset:5px;}"
    },
