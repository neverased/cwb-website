{
  "name": "cwb-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone-dependencies.mjs",
    "start": "node scripts/prepare-standalone-assets.mjs && node .next/standalone/server.js",
    "test": "pnpm test:contact && pnpm test:seo",
    "test:seo": "tsx scripts/seo-regression.ts",
    "test:contact": "tsx scripts/contact-antispam-regression.ts",
    "test:cms": "tsx scripts/cms-regression.ts",
    "test:quotes": "tsx scripts/quotes-domain-regression.ts && tsx scripts/quotes-pdf-regression.ts",
    "test:quotes:integration": "tsx scripts/quotes-integration.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cms:setup": "node scripts/setup-cms-env.mjs",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uit/glitch-image": "^0.0.11",
    "graphql": "16.14.2",
    "highlight.js": "^11.12.0",
    "jquery": "^4.0.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "payload": "3.90.2",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "coffeescript": "^2.7.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.5.2",
    "oxlint": "1.85.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.6.0"
}
