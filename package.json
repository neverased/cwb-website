{
  "name": "cwb-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone-dependencies.mjs",
    "start": "node scripts/prepare-standalone-assets.mjs && node .next/standalone/server.js",
    "test": "pnpm test:contact && pnpm test:seo && pnpm test:services && pnpm test:standalone",
    "test:standalone": "node --test scripts/standalone-dependencies-regression.mjs",
    "test:dependencies": "tsx scripts/dependency-security-regression.ts",
    "test:seo": "tsx scripts/seo-regression.ts && tsx scripts/service-pages-regression.ts && tsx scripts/post-seo-regression.ts",
    "test:seo:http": "tsx scripts/seo-http-regression.ts",
    "test:contact": "tsx scripts/contact-antispam-regression.ts",
    "test:cms": "tsx scripts/cms-regression.ts",
    "test:cms:browser": "node scripts/cms-browser-regression.ts",
    "test:quotes": "tsx scripts/quotes-domain-regression.ts && tsx scripts/quotes-pdf-regression.ts",
    "test:quotes:integration": "tsx scripts/quotes-integration.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cms:setup": "node scripts/setup-cms-env.mjs",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "pnpm lint --fix",
    "test:services": "tsx scripts/service-intents-regression.ts",
    "test:security": "pnpm test:dependencies && node --import tsx scripts/contact-security-regression.ts && node --import tsx scripts/contact-http-regression.ts && node --import tsx scripts/contact-mail-regression.ts && node --import tsx scripts/contact-mail-tls-regression.ts && node --test scripts/security-config-regression.mjs scripts/live-state-exclusion-regression.mjs",
    "test:security:tls": "node --test scripts/backend-tls-regression.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uit/glitch-image": "^0.0.11",
    "graphql": "17.1.0",
    "highlight.js": "^11.12.0",
    "jquery": "^4.0.0",
    "monaco-editor": "0.57.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "payload": "3.93.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/three": "0.187.0",
    "coffeescript": "^2.7.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^31.0.0",
    "oxlint": "1.93.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.18.0"
}
